[MAIN]
init-hook='import sys; sys.path.append(".")'
fail-on=E,F
fail-under=0

[DESIGN]
max-args=8

[FORMAT]
max-line-length=160

[MESSAGES CONTROL]
disable=missing-docstring,
        bare-except,
        broad-exception-caught,
        broad-exception-raised,
        consider-using-f-string,
        logging-fstring-interpolation,
        logging-format-interpolation,
        abstract-method,
        invalid-name
